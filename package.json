{
  "name": "ai-bookworm",
  "private": true,
  "version": "0.1.0",
  "description": "AI Book Publishing SaaS — monorepo",
  "workspaces": [
    "apps/web",
    "services/api",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
