# Copy to an ignored private environment file. Never commit real tokens.
# The Python executable defaults to this repository's .venv.
BOOKWORM_PYTHON=
# Optional absolute path to the reviewed EPUBCheck 5.4.0 epubcheck.jar.
# Java must also be available on PATH. Required for Apple/Google EPUB packaging.
EPUBCHECK_JAR=
DOCUMENT_SERVICE_URL=http://127.0.0.1:8001
DOCUMENT_SERVICE_TOKEN=<set-a-distinct-random-32-byte-secret>
RENDERING_SERVICE_URL=http://127.0.0.1:8002
RENDERING_SERVICE_TOKEN=<set-a-distinct-random-32-byte-secret>
PUBLISHING_SERVICE_URL=http://127.0.0.1:8003
PUBLISHING_SERVICE_TOKEN=<set-a-distinct-random-32-byte-secret>
SCANNING_SERVICE_URL=http://127.0.0.1:8004
SCANNING_SERVICE_TOKEN=<set-a-distinct-random-32-byte-secret>
CLAMD_PORT=3310
