# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI providers (never commit real values)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=anthropic
DEFAULT_AI_MODEL=claude-sonnet-4-6

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON map of plans.id -> Stripe price id, e.g. {"<plan-uuid>":"price_123"}
STRIPE_PRICE_IDS_JSON={}

# Service-to-service shared secret (AI/document/render services -> API /v1/credits/deduct)
SERVICE_AUTH_TOKEN=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# App
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_TOKEN=
AI_SERVICE_PORT=8000
NODE_ENV=development
LOG_LEVEL=info
