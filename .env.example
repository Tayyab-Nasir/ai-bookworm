# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OpenAI generation (never commit real values)
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-6-astra
OPENAI_TRANSLATION_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Server-only, approved quote catalogs. Leave blank until each model's current
# provider cost and customer-credit policy have been independently approved.
TRANSLATION_PRICING_CATALOG_JSON=
STORY_BLUEPRINT_PRICING_CATALOG_JSON=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON map of plans.id -> Stripe price id, e.g. {"<plan-uuid>":"price_123"}
STRIPE_PRICE_IDS_JSON={}

# Service-to-service shared secret (AI/document/render services -> API /v1/credits/deduct)
SERVICE_AUTH_TOKEN=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# App
API_PORT=3001
WEB_PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_TOKEN=
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
# Metadata generation requires SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and the
# receipt migration on the AI worker too. Real providers always use Supabase.
# Set this only to exercise the durable store with the deterministic mock.
AI_RESULT_STORE=
DOCUMENT_SERVICE_URL=http://127.0.0.1:8001
DOCUMENT_SERVICE_TOKEN=
# Optional worker import folder. HTTP uploads use bytes; filesystem access stays
# disabled unless this directory is explicitly configured on the document service.
DOCUMENT_IMPORT_ROOT=
RENDERING_SERVICE_PORT=8002
RENDERING_SERVICE_URL=http://127.0.0.1:8002
RENDERING_SERVICE_TOKEN=
PUBLISHING_SERVICE_PORT=8003
PUBLISHING_SERVICE_URL=http://127.0.0.1:8003
PUBLISHING_SERVICE_TOKEN=
SCANNING_SERVICE_URL=http://127.0.0.1:8004
SCANNING_SERVICE_TOKEN=
SCANNING_SERVICE_TIMEOUT_MS=30000
CLAMD_HOST=clamd
CLAMD_PORT=3310
SCANNING_MAX_FILE_BYTES=104857600
NODE_ENV=development
LOG_LEVEL=info
